# Composer dev dependencies — the plugin itself has no runtime dependencies.
/vendor/

# PHPUnit
/.phpunit.result.cache
/phpunit.xml

# Build output. The directory matters as much as the archive: without it a
# `git add -A` commits the staged plugin tree, and `git archive` then nests a
# copy of the plugin inside its own release ZIP.
/build/
/*.zip

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
