msgid ""
msgstr ""
"Project-Id-Version: Yappy Payment Button for WooCommerce 1.0.0\n"
"Report-Msgid-Bugs-To: https://github.com/lammworks/woocommerce-yappyv2/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"Language: es\n"
"X-Domain: woocommerce-yappy\n"

msgid "Accept payments with Yappy, the mobile payment service from Banco General (Panamá). Uses the new Botón de Pago Yappy integration."
msgstr "Acepta pagos con Yappy, el servicio de pago móvil de Banco General (Panamá). Utiliza la nueva integración del Botón de Pago Yappy."

msgid "Advanced"
msgstr "Avanzado"

msgid "Amount to pay: %s"
msgstr "Monto a pagar: %s"

msgid "Ask for the phone number"
msgstr "Solicitar el número de teléfono"

msgid "Ask the customer for their Yappy phone number"
msgstr "Pedir al cliente su número de teléfono de Yappy"

msgid "Awaiting Yappy payment."
msgstr "En espera del pago con Yappy."

msgid "Blue"
msgstr "Azul"

msgid "Button"
msgstr "Botón"

msgid "Button theme"
msgstr "Estilo del botón"

msgid "Cancel and choose another payment method"
msgstr "Cancelar y elegir otro método de pago"

msgid "Cancelled"
msgstr "Cancelado"

msgid "Confirming your payment with Yappy…"
msgstr "Confirmando tu pago con Yappy…"

msgid "Continue to Yappy"
msgstr "Continuar a Yappy"

msgid "Credentials"
msgstr "Credenciales"

msgid "Dark"
msgstr "Oscuro"

msgid "Dark blue"
msgstr "Azul oscuro"

msgid "Debug log"
msgstr "Registro de depuración"

msgid "Delete the settings of this plugin when it is uninstalled"
msgstr "Eliminar los ajustes de este plugin al desinstalarlo"

msgid "Description"
msgstr "Descripción"

msgid "Enable Yappy"
msgstr "Activar Yappy"

msgid "Enable/Disable"
msgstr "Activar/Desactivar"

msgid "Enter a valid Panamanian mobile number, for example 61234567. Leave it empty to pay by QR code."
msgstr "Escribe un número celular panameño válido, por ejemplo 61234567. Déjalo vacío para pagar con código QR."

msgid "Environment"
msgstr "Entorno"

msgid "Executed"
msgstr "Ejecutado"

msgid "Expired"
msgstr "Expirado"

msgid "Ignored a late Yappy notification (%s) because the order is already paid."
msgstr "Se ignoró una notificación tardía de Yappy (%s) porque el pedido ya está pagado."

msgid "JavaScript is required to pay with Yappy. Please enable it and reload this page."
msgstr "Se necesita JavaScript para pagar con Yappy. Actívalo y vuelve a cargar esta página."

msgid "Light"
msgstr "Claro"

msgid "Log Yappy requests and notifications"
msgstr "Registrar las peticiones y notificaciones de Yappy"

msgid "Merchant ID"
msgstr "ID del comercio"

msgid "Must match the domain registered in Yappy Comercial, exactly. Leave empty to use %s."
msgstr "Debe coincidir exactamente con el dominio registrado en Yappy Comercial. Déjalo vacío para usar %s."

msgid "Orange"
msgstr "Naranja"

msgid "Pay with your Yappy app from Banco General. You will confirm the payment on your phone."
msgstr "Paga con tu app de Yappy de Banco General. Confirmarás el pago desde tu teléfono."

msgid "Production"
msgstr "Producción"

msgid "Registered domain"
msgstr "Dominio registrado"

msgid "Rejected"
msgstr "Rechazado"

msgid "Remove data on uninstall"
msgstr "Eliminar los datos al desinstalar"

msgid "Render the Yappy button with rounded corners"
msgstr "Mostrar el botón de Yappy con esquinas redondeadas"

msgid "Rounded corners"
msgstr "Esquinas redondeadas"

msgid "Sandbox (UAT)"
msgstr "Pruebas (UAT)"

msgid "Saved under %s. Errors are always logged; this adds the request-level detail."
msgstr "Se guarda en %s. Los errores siempre se registran; esto añade el detalle de cada petición."

msgid "Secret key"
msgstr "Clave secreta"

msgid "Settings"
msgstr "Ajustes"

msgid "Sky"
msgstr "Celeste"

msgid "Something went wrong with Yappy. Please try again."
msgstr "Algo salió mal con Yappy. Inténtalo nuevamente."

msgid "The Yappy button could not be loaded. Please refresh the page and try again."
msgstr "No se pudo cargar el botón de Yappy. Recarga la página e inténtalo nuevamente."

msgid "The Yappy payment request expired before it was confirmed."
msgstr "La solicitud de pago de Yappy expiró antes de ser confirmada."

msgid "The merchant ID issued in Yappy Comercial."
msgstr "El ID del comercio emitido en Yappy Comercial."

msgid "The name the customer sees at checkout."
msgstr "El nombre que ve el cliente al pagar."

msgid "The order amounts are not valid for Yappy."
msgstr "Los montos del pedido no son válidos para Yappy."

msgid "The order could not be found."
msgstr "No se encontró el pedido."

msgid "The order reference is too long for Yappy (maximum 15 characters)."
msgstr "La referencia del pedido es demasiado larga para Yappy (máximo 15 caracteres)."

msgid "The secret key issued in Yappy Comercial. Used to verify that payment notifications really come from Yappy."
msgstr "La clave secreta emitida en Yappy Comercial. Se usa para verificar que las notificaciones de pago provienen realmente de Yappy."

msgid "The store URL configured for Yappy is not valid."
msgstr "La URL de la tienda configurada para Yappy no es válida."

msgid "The text shown under the payment method at checkout."
msgstr "El texto que aparece debajo del método de pago al finalizar la compra."

msgid "This order has already been paid."
msgstr "Este pedido ya fue pagado."

msgid "This order has already been registered with Yappy. Please refresh the page and try again."
msgstr "Este pedido ya fue registrado en Yappy. Recarga la página e inténtalo nuevamente."

msgid "This phone number is not registered with Yappy."
msgstr "Este número no está registrado en Yappy."

msgid "Title"
msgstr "Título"

msgid "Unknown"
msgstr "Desconocido"

msgid "Use Sandbox to test against the Yappy UAT environment. Sandbox credentials do not work in production and vice versa."
msgstr "Usa Pruebas para probar contra el entorno UAT de Yappy. Las credenciales de pruebas no funcionan en producción ni viceversa."

msgid "We have not received the confirmation from Yappy yet. This page will reflect the payment as soon as Yappy notifies us."
msgstr "Todavía no hemos recibido la confirmación de Yappy. Esta página reflejará el pago en cuanto Yappy nos notifique."

msgid "We will send the payment request straight to this number. Leave it empty to pay by scanning a QR code instead."
msgstr "Enviaremos la solicitud de pago directamente a este número. Déjalo vacío para pagar escaneando un código QR."

msgid "When enabled the payment request is pushed straight to that number. When disabled — or when the customer leaves it empty — Yappy shows a QR code instead."
msgstr "Si está activo, la solicitud de pago se envía directamente a ese número. Si está inactivo —o si el cliente lo deja vacío— Yappy muestra un código QR."

msgid "Yappy"
msgstr "Yappy"

msgid "Yappy Payment Button for WooCommerce requires WooCommerce to be installed and active."
msgstr "Botón de Pago Yappy para WooCommerce necesita que WooCommerce esté instalado y activo."

msgid "Yappy is disabled"
msgstr "Yappy está desactivado"

msgid "Yappy is not configured for this store."
msgstr "Yappy no está configurado en esta tienda."

msgid "Yappy is temporarily unavailable. Please choose another payment method."
msgstr "Yappy no está disponible en este momento. Elige otro método de pago."

msgid "Yappy notifies this store of every payment result at the following URL. It must be reachable from the internet over HTTPS:"
msgstr "Yappy notifica a esta tienda el resultado de cada pago en la siguiente URL. Debe ser accesible desde internet por HTTPS:"

msgid "Yappy only settles in %s. Change the store currency to offer it."
msgstr "Yappy solo liquida en %s. Cambia la moneda de la tienda para ofrecerlo."

msgid "Yappy order created. Reference: %1$s. Transaction: %2$s."
msgstr "Orden de Yappy creada. Referencia: %1$s. Transacción: %2$s."

msgid "Yappy payment cancelled by the customer."
msgstr "Pago con Yappy cancelado por el cliente."

msgid "Yappy payment executed. Reference: %1$s. Confirmation: %2$s."
msgstr "Pago con Yappy ejecutado. Referencia: %1$s. Confirmación: %2$s."

msgid "Yappy payment rejected by the customer."
msgstr "Pago con Yappy rechazado por el cliente."

msgid "Yappy requires HTTPS"
msgstr "Yappy requiere HTTPS"

msgid "Yappy will not deliver payment notifications to a store that is not served over HTTPS."
msgstr "Yappy no entregará notificaciones de pago a una tienda que no se sirva por HTTPS."

msgid "Your Yappy phone number"
msgstr "Tu número de teléfono de Yappy"

msgid "Your session expired. Please refresh the page and try again."
msgstr "Tu sesión expiró. Recarga la página e inténtalo nuevamente."

msgid "not provided"
msgstr "no proporcionada"
